# FastAPI security (leave unset for local dev without auth)
CHURN_API_KEY=change-me-in-production

# Base URL shown in Streamlit sidebar API links (change after deploy)
CHURN_API_BASE_URL=http://127.0.0.1:8000

# Runtime environment label exposed on /health
ENVIRONMENT=development

# Logging: INFO, DEBUG, WARNING
LOG_LEVEL=INFO

# Set true in Docker/production for JSON log lines
LOG_JSON=false
